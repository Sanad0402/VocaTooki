import requests

# Define the API endpoint URL
url = "http://vtbe.vocatooki.com/data/get-user-state"

# Send the request 100 times
for i in range(100):
    response = requests.get(url)

    # Check if the request was successful (status code 200)
    if response.status_code == 200:
        data = response.json()

        # Print the level from the response
        print(f"Request {i + 1}: Level {data['level']}")
    else:
        print(f"Request {i + 1}: Error - Status Code {response.status_code}")

