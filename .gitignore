# Cleanup backup (staged for review before permanent deletion)
_cleanup_backup/

# Local machine-specific / junk artifacts
.claude/settings.local.json
*.stackdump

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environment
venv/
.env/
.venv/

# Test / temp files
*.log
*.tmp
*.bak
*.swp
*.swo
AltTester.log

# Reports & screenshots
*.xml
*.html
*.screens.zip
reports/
screenshots/

# Sensitive config
.env
.env.*
*.env
!*.env.template
rally.env
automation_email.env
debug_*.py
data/test_users.py
# Panel runtime state (Last-runs history)
data/run_history.json
panel.log
panel.err.log

# AltTester CLI scratch (scene snapshots written by every MCP/CLI command)
.alttester-cli/

# Live-run debris at the repo root. Anchored with a leading slash so a file that
# legitimately shares one of these names deeper in the tree is still tracked —
# /screenshot.png in particular is scratch, NOT the per-run evidence shots the
# panel writes (those live under screenshots/ and reports/).
/err.txt
/se.txt
/out.json
/s.json
/screenshot.png

# QA checklists kept at the repo root. Root-anchored on purpose: these are
# working copies that get a new file per release (VocaTooki_4.6.0_QA_...), so a
# name-by-name rule would need editing every version, while an unanchored
# *.xlsx would also swallow a spreadsheet someone deliberately versions inside
# the tree.
/*.xlsx
